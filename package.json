{
  "name": "pane-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling"
  ],
  "scripts": {
    "init": "scode init",
    "build": "bun tooling/src/app/entrypoints/build.ts",
    "dev": "bun run build && bun apps/demo/src/app/entrypoints/server.ts",
    "start": "bun apps/demo/src/app/entrypoints/server.ts",
    "desktop": "bun run build && bun apps/demo/src/app/entrypoints/desktop.ts",
    "lint": "scode lint",
    "doctor": "scode doctor --root .",
    "format": "prettier --write .",
    "benchmark": "bun tooling/src/app/entrypoints/benchmark.ts",
    "pack": "bun run build && bun tooling/src/app/entrypoints/pack.ts",
    "typecheck": "tsc --project tsconfig.check.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "electron": "39.8.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
